# --- Database (Neon Postgres) ---
DATABASE_URL=          # pooled connection (runtime)
DIRECT_URL=            # non-pooled connection (used by Prisma migrations)

# --- Better Auth ---
BETTER_AUTH_SECRET=    # random 32+ char secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- OAuth providers (for Google/GitHub sign-in + avatars) ---
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers (OAuth Apps)
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Set to "true" only on networks with broken IPv6 (local dev). Leave unset in cloud.
PREFER_IPV4=

# --- Transactional email (Resend) ---
# Get your API key at https://resend.com/api-keys
# Leave unset in local dev — invite links will be logged to console instead.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Shared secret for the nightly cleanup cron (set the same value on each Netlify site)
CRON_SECRET=
