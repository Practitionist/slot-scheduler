generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Better Auth required tables
model User {
  id            String             @id
  name          String
  email         String             @unique
  emailVerified Boolean
  image         String?
  timezone      String             @default("Asia/Kolkata") // IANA tz name; slot HH:MM are wall-clock in this zone
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  slots         AvailabilitySlot[]
  members       Member[]
  teamMembers   TeamMember[]
  sentInvitations       Invitation[]          @relation("SentInvitations")
  organizedAppointments Appointment[]         @relation("OrganizedAppointments")
  appointmentInvites    AppointmentAttendee[] @relation("AppointmentInvites")
  productMembers        ProductMember[]
  createdJoinCodes      JoinCode[]            @relation("CreatedJoinCodes")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Better Auth organization plugin: tracks the session's active org/team
  activeOrganizationId String?
  activeTeamId         String?
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@unique([providerId, accountId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@unique([identifier, value])
}

model AvailabilitySlot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0=Mon ... 6=Sun
  startTime String   // "HH:MM" wall-clock in the owning user's timezone (User.timezone)
  endTime   String   // "HH:MM" wall-clock in the owning user's timezone (User.timezone)
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dayOfWeek, startTime, endTime])
  @@index([dayOfWeek, startTime, endTime])
  @@index([userId])
}

// ── Better Auth organization plugin tables ──────────────────────────────────
model Organization {
  id          String       @id
  name        String
  slug        String       @unique
  logo        String?
  metadata    String?
  createdAt   DateTime
  updatedAt   DateTime?
  members     Member[]
  invitations Invitation[]
  teams       Team[]
  products    Product[]
  joinCodes   JoinCode[]
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  teamId         String?
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  teamId         String?
  inviterId      String
  inviter        User         @relation("SentInvitations", fields: [inviterId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  createdAt      DateTime

  @@index([organizationId])
  @@index([email])
}

model Team {
  id             String       @id
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime
  updatedAt      DateTime?
  teamMembers    TeamMember[]
}

model TeamMember {
  id        String   @id
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime

  @@unique([teamId, userId])
  @@index([userId])
}

// ── Appointments (one-off meetings with RSVP) ───────────────────────────────
model Appointment {
  id          String                @id @default(cuid())
  organizerId String
  organizer   User                  @relation("OrganizedAppointments", fields: [organizerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startsAt    DateTime // absolute UTC instant
  endsAt      DateTime // absolute UTC instant
  timezone    String   // organizer's IANA tz the meeting was scheduled in
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  attendees   AppointmentAttendee[]

  @@index([organizerId])
  @@index([startsAt])
}

model AppointmentAttendee {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation("AppointmentInvites", fields: [userId], references: [id], onDelete: Cascade)
  status        String      @default("pending") // pending | accepted | declined
  respondedAt   DateTime?

  @@unique([appointmentId, userId])
  @@index([userId])
}

// ── Product: a cross-cutting grouping orthogonal to Team (matrix orgs) ───────
// A Product belongs to an Org and groups members directly (many-to-many), so it
// works whether a company thinks of "product" as above or below team. See #6.
model Product {
  id             String          @id @default(cuid())
  name           String
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  members        ProductMember[]

  @@index([organizationId])
}

model ProductMember {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([userId])
}

// ── Join codes: invite-link alternative — share a code, skip per-email invite ─
model JoinCode {
  id          String       @id @default(cuid())
  code        String       @unique
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teamId      String?      // if set, also adds joiner to this team
  productId   String?      // if set, also adds joiner to this product
  role        String       @default("member")
  expiresAt   DateTime?    // null = never expires
  maxUses     Int?         // null = unlimited
  uses        Int          @default(0)
  createdById String
  createdBy   User         @relation("CreatedJoinCodes", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@index([orgId])
  @@index([code])
}
